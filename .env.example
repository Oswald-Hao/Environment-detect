# =============================================================
# Backend secrets — copy this file to .env.local and fill in.
# .env* is gitignored except for this template.
# =============================================================

# iNaturalist JWT token (24h lifetime).
# Get one (free) at https://www.inaturalist.org/users/api_token
# after signing up at https://www.inaturalist.org/signup
INAT_TOKEN="paste-your-jwt-here"

# Google Gemini key — used to synthesise the description / habitat /
# fun-fact text for the identified species. If unset, the backend
# returns stub text and identification still works.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Backend HTTP port. Vite dev-server proxies /api to this port.
PORT=8787

# Optional: where the applet is hosted (used by AI Studio).
APP_URL="MY_APP_URL"
